# ============================================================
# SOS Orçamentos (Higifácil) — variáveis de ambiente
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env de verdade.
# ============================================================

# --- Banco de Dados (obrigatório) -----------------------------------------
# MySQL 8+ ou TiDB. Se for continuar no TiDB Cloud, troque a senha antes
# de usar (a antiga vazou e precisa ser rotacionada).
DATABASE_URL=mysql://usuario:senha@host:3306/nome_do_banco

# --- Autenticação e Sessão (obrigatório) -----------------------------------
# Gere uma chave nova e aleatória (ex: openssl rand -hex 32).
# NÃO reaproveitar a chave antiga — ela também vazou.
JWT_SECRET=

# --- Servidor (obrigatório) -------------------------------------------------
PORT=3000
NODE_ENV=production

# --- Cron do bloqueio de trial vencido (obrigatório em produção) -----------
# Protege POST /api/scheduled/expire-trials. O agendador da infraestrutura
# (ex: Railway Cron Jobs, rodando 1x/dia) deve chamar essa rota enviando
# "Authorization: Bearer <CRON_SECRET>". Gere com: openssl rand -hex 32
CRON_SECRET=

# --- Storage de arquivos: Cloudflare R2 (obrigatório para upload) ----------
# Dois buckets na MESMA conta/credencial R2 — a visibilidade é o bucket, não
# a credencial (ver server/storage.ts):
#   público  → fotos de cliente/tapete/execução, avatar, catálogo de serviços
#   privado  → comprovantes de venda/execução, extratos bancários (nunca por
#              URL fixa — só link assinado gerado sob demanda)
R2_ENDPOINT=                    # https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=higifacil-fotos-publicas
R2_PRIVATE_BUCKET_NAME=higifacil-documentos-privados
# Custom domain na frente do bucket público (opcional, mas recomendado —
# sem isso cai na URL padrão do endpoint R2, que funciona mas não é bonita)
R2_PUBLIC_DOMAIN=

# --- Stripe (pagamentos) ----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_LIVE=
VITE_STRIPE_PUBLISHABLE_KEY=
# IDs dos preços cadastrados no Stripe (não são segredo, mas são obrigatórios
# para a tela de Planos funcionar — sem eles o checkout não sabe o que cobrar)
STRIPE_PRICE_SOLO=
STRIPE_PRICE_DUPLA=
STRIPE_PRICE_EQUIPE=

# --- E-mail transacional (Resend) ------------------------------------------
RESEND_API_KEY=

# --- OAuth da Manus (OPCIONAL, recomendado deixar em branco) ---------------
# Deixe em branco para desativar o login via Manus e usar só e-mail/senha.
# Como só existe um usuário "dono" hoje, a recomendação (ver README-MIGRACAO)
# é não manter isso vivo.
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_OAUTH_PORTAL_URL=

# --- Login "Entrar com Google" (OPCIONAL) -----------------------------------
# Client ID do Google Identity Services (OAuth 2.0), do Google Cloud Console.
# Sem isso, o botão "Entrar com Google" some e sobra só e-mail/senha.
VITE_GOOGLE_CLIENT_ID=

# --- IA: sugestão de orçamento, mensagem de reativação, categorização de
# extrato bancário (OPCIONAL) -------------------------------------------------
# Sem essa chave, essas 3 features retornam erro ao serem usadas — o resto
# do sistema funciona normalmente.
OPENAI_API_KEY=

# --- Notificações internas para o dono do sistema (OPCIONAL) ---------------
# E-mail que recebe alertas de nova solicitação de acesso, novo agendamento
# de demo, nova empresa via Stripe, feedback beta, etc. Sem isso, as
# notificações só ficam no log do servidor.
NOTIFY_OWNER_EMAIL=

# --- Google Maps: autocompletar de endereço, mapa e cálculo de deslocamento
# (OPCIONAL) ------------------------------------------------------------------
# Chave de API do Google Cloud Console com Places API, Geocoding API,
# Distance Matrix API e Directions API habilitadas. Fica exposta no bundle
# do navegador (prefixo VITE_) — restrinja por domínio/referrer no Google
# Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
# Opcional: uma segunda chave só para as chamadas feitas pelo servidor
# (estimativa de pedágio) — sem restrição de referrer, já que requisição
# server-to-server não envia header Referer de navegador. Se deixar em
# branco, o servidor tenta usar a chave acima (só funciona se ela não tiver
# restrição de referrer).
GOOGLE_MAPS_SERVER_API_KEY=

# --- App ---------------------------------------------------------------------
VITE_APP_ID=
